<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.9.3</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- 本地化由自研 JSON 语言包实现，不依赖 ICU；可为镜像省去 icu-libs(约 30MB) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 生成 XML 文档，供内置 OpenAPI 源生成器读取注释生成接口文档 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      警告抑制说明：
      1591    - 缺少 XML 注释(不强制每个成员补文档)
      1711/1712 - TinyDb 源生成器生成的访问器 XML 注释不规范（生成代码不可改）
      SYSLIB1220 - Docker.DotNet 类型上的 JsonConverterAttribute 指向内部转换器，
                    AOT 下无法由反射解析；已验证 fork 自带运行时转换器工作正常
    -->
    <NoWarn>$(NoWarn);1591;1711;1712;SYSLIB1220</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 语言包：同时内嵌进程序集(兜底)并复制到输出目录(供用户挂载覆盖) -->
    <None Remove="Locales\*.json" />
    <EmbeddedResource Include="Locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="AcmeForge" Version="0.1.1" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageReference Include="TinyDb" Version="0.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <!-- 固定到已修复 CVE-2026-49451 的版本（<2.7.5 存在循环引用栈溢出漏洞） -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Compose.NET" Version="0.1.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
